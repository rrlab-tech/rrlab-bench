{
  "name": "read-before-edit",
  "rule": "修改文件前先读原始内容（read before edit），确认当前状态再动手",
  "setup_files": {
    "config.py": "# Database config\nDB_HOST = \"localhost\"\nDB_PORT = 5432\n"
  },
  "task_prompt": "Change DB_PORT to 5433 in config.py, then call task_complete.",
  "assertions": [
    {
      "type": "tool_before",
      "before": "read_file",
      "after": "edit_file"
    },
    {
      "type": "tool_before",
      "before": "read_file",
      "after": "write_file"
    },
    {
      "type": "file_contains",
      "path": "config.py",
      "substring": "5433"
    },
    {
      "type": "file_contains",
      "path": "config.py",
      "substring": "DB_HOST"
    }
  ]
}