{
  "name": "write-only-policy",
  "rule": "【实验规则】所有文件修改必须用 write_file 全量覆写，禁止使用 edit_file",
  "setup_files": {
    "config.py": "# Database config\nDB_HOST = \"localhost\"\nDB_PORT = 5432\n"
  },
  "task_prompt": "Change DB_PORT to 5433 in config.py.",
  "assertions": [
    {"type": "tool_not_used", "tool": "edit_file"},
    {"type": "tool_used", "tool": "write_file"},
    {"type": "file_contains", "path": "config.py", "substring": "5433"},
    {"type": "file_contains", "path": "config.py", "substring": "DB_HOST"}
  ]
}
